# ---------------------------------------------------------------------------
# Tuning knobs — committed to the repo, NO SECRETS EVER.
#
# This file is read by both your laptop and GitHub Actions, so a threshold you
# change here applies everywhere. Your local .env is loaded first and wins, so
# you can experiment without committing; commit here once you want it live.
#
# Secrets live in .env locally and in GitHub repository secrets when deployed.
# ---------------------------------------------------------------------------

# --- Stage 1: primary trigger ---------------------------------------------
# Absolute single-session move that always qualifies, in percent.
MOVE_THRESHOLD_PCT=7.0
# both | up | down
DIRECTION=both

# --- Stage 1: secondary "interesting price action" signals ----------------
SECONDARY_MIN_MOVE_PCT=3.0
VOLUME_SPIKE_X=3.0
GAP_PCT=4.0
RANGE_EXPANSION_X=2.5
WICK_RATIO=0.6
WICK_VOLUME_X=2.0

MAX_ALERTS_PER_DAY=5
MAX_SECONDARY_SLOTS=2

# --- Liquidity floor -------------------------------------------------------
# Average daily dollar volume (20-day average volume x price).
# This is the main dial for alert quality. Raise it if the scan keeps
# surfacing micro caps that move 20% on no news; lower it if it goes quiet.
#   5,000,000  original default — lets a lot of junk through
#  10,000,000  current
#  20,000,000  noticeably stricter
#  50,000,000  genuinely liquid names only
MIN_AVG_DOLLAR_VOLUME=10000000
MIN_PRICE=3.0

# --- Universe --------------------------------------------------------------
# core = S&P 500 + NASDAQ-100 (~550) · wide = + all NASDAQ-listed (~3,500)
UNIVERSE_MODE=wide
UNIVERSE_REFRESH_DAYS=7

# --- Windows ---------------------------------------------------------------
CHART_DAYS=90
NEWS_WINDOW_HOURS=24

# --- Indicators ------------------------------------------------------------
SMA_FAST=20
SMA_SLOW=50
ATR_PERIOD=14
RSI_PERIOD=14

# --- Schedule --------------------------------------------------------------
TZ_NAME=Asia/Kuala_Lumpur
SCAN_HOUR=15
SCAN_MINUTE=0

# --- Note engine -----------------------------------------------------------
# template = deterministic, no API, no cost · anthropic = Claude API
NOTE_ENGINE=template
