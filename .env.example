# ---------------------------------------------------------------------------
# InsideMove Agent — copy to .env and fill in. SECRETS ONLY.
#
# Thresholds and tuning live in settings.env, which is committed so your
# laptop and GitHub Actions stay in sync. Anything you put here overrides it
# locally without being committed — handy for experiments.
# ---------------------------------------------------------------------------

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your own chat id. Start the bot, send it /chatid, and it replies with this.
# Also locks the bot to your chat so nobody else can trigger scans.
TELEGRAM_CHAT_ID=

# finnhub.io — free tier, no card. Without it, news falls back to Yahoo and
# insider filings / analyst ratings are reported as unavailable.
FINNHUB_API_KEY=

# Only needed if you set NOTE_ENGINE=anthropic in settings.env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- local experiments -----------------------------------------------------
# Uncomment to override settings.env on this machine only:
# MIN_AVG_DOLLAR_VOLUME=20000000
# MOVE_THRESHOLD_PCT=4
# UNIVERSE_MODE=core
